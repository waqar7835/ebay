DATABASE_URL="postgresql://ebay:ebay@localhost:5432/ebay_order_management?schema=public"
# Set to "true" in production when connecting to a Postgres provider that requires SSL
# (Railway's public proxy does; Railway private networking usually does not).
DB_SSL=false
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
PORT=4000

# Frontend URLs used to build email links
BACKOFFICE_URL="http://localhost:3001"
PORTAL_URL="http://localhost:3000"

# Comma-separated list of allowed CORS origins in production, e.g.
# FRONTEND_URLS="https://app.example.com,https://backoffice.example.com"
# Leave blank in dev to allow all origins.
FRONTEND_URLS=

# SMTP (leave blank in dev to just log emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="eBay Order Management <no-reply@example.com>"

# Local file uploads (used when R2 is not configured, e.g. local dev)
UPLOADS_DIR="uploads"

# Cloudflare R2 (S3-compatible) file storage. Leave R2_ACCOUNT_ID blank to fall
# back to local disk storage under UPLOADS_DIR instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (R2.dev subdomain or a custom domain), no trailing slash
R2_PUBLIC_URL=
